APP_ENV=development
AGENT_PROVIDER=mock
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://complaintops:complaintops@localhost:5432/complaintops
CFPB_API_BASE_URL=https://www.consumerfinance.gov/data-research/consumer-complaints/search/api/v1/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Use local for development/private preview. Use oidc for a public deployment.
AUTH_MODE=local
OPERATOR_USERNAME=
OPERATOR_PASSWORD_HASH=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
# Comma-separated emails allowed to create the first administrator account.
OIDC_ADMIN_EMAILS=
SESSION_SECRET=
SESSION_HOURS=12
PUBLIC_ORIGIN=
